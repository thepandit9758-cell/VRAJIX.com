# VRAJIX Studio Security & Environment Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://vrajix.com

# SECURITY CHECK #3: Admin Secret Key for Accessing Client Enquiries API
# (Never share this key with clients or publish to GitHub)
ADMIN_API_KEY=vrajix_super_secret_production_key_replace_this

# SECURITY CHECK #4: Email Credentials (Isolate in .env, never in frontend)
SMTP_USER=vrajix11@gmail.com
SMTP_PASS=your_google_app_password_here

# Database Configuration
DB_TYPE=sqlite
SQLITE_DB_PATH=./database/vrajix_enquiries.sqlite
